# Copia este archivo como .env.local y pon ahí tu llave.
# .env.local está en .gitignore: nunca se sube al repositorio.

# ---------------------------------------------------------------
# Opción A — desarrollo en tu máquina
# ---------------------------------------------------------------
# La llave viaja en el navegador. Sirve para trabajar tú solo.
# Se saca en https://platform.claude.com/settings/keys
VITE_ANTHROPIC_API_KEY=


# ---------------------------------------------------------------
# Opción B — despliegue compartido (recomendada cuando haya equipo)
# ---------------------------------------------------------------
# Un backend propio guarda la llave y habla con Anthropic. El navegador
# nunca la ve. Si defines esto, la opción A se ignora.
# El endpoint recibe { model, system, messages, schema } y devuelve el texto.
VITE_IA_PROXY_URL=
